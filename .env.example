# Copy this file to `.env` and fill in your Supabase project values.
# Find these in your Supabase dashboard under: Project Settings -> API
#
# The anon/public key is safe to expose in a client app *as long as*
# Row Level Security is enabled (it is — see supabase/schema.sql).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Server-only (set these in Vercel → Project → Settings → Environment
# Variables, NOT in the client bundle). Used by api/feedback.js to email bug
# reports / feature requests via Resend. The Supabase URL/anon key above are
# reused automatically; you only need to add:
#   RESEND_API_KEY=re_xxx              # from resend.com
#   FEEDBACK_TO=tobias@reidel.net      # optional, this is the default
#   FEEDBACK_FROM=Treningsdagbok <feedback@reidel.net>   # optional; needs a
#                                       # verified Resend domain (else omit to
#                                       # use Resend's shared test sender)
# ---------------------------------------------------------------------------
